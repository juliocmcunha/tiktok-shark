# -----------------------------------------------------------------------------
# Configuração do servidor intermediário TikTok -> Roblox
# Copie este arquivo para ".env" e preencha os valores.
#   cp .env.example .env
# -----------------------------------------------------------------------------

# Porta HTTP em que o servidor vai escutar.
PORT=3000

# Nome de usuário do TikTok da live que será monitorada (sem o "@").
# A pessoa PRECISA estar ao vivo para a conexão ser estabelecida.
TIKTOK_USERNAME=nomedousuario

# Chave secreta exigida no header "x-api-key" do endpoint /api/events.
# Use algo longo e aleatório. Gere uma, por exemplo, com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# -----------------------------------------------------------------------------
# Modo de teste (para testar a integração com o Roblox SEM abrir uma live)
# -----------------------------------------------------------------------------

# Se "true": NÃO conecta no TikTok. Sobe só o HTTP + console de simulação.
# Ótimo para desenvolver o jogo no Roblox antes de ter uma live de verdade.
# SIMULATE_ONLY=false

# Console interativo (stdin) para simular eventos digitando comandos.
# Por padrão liga sozinho quando há terminal (TTY). Force com true/false.
# ENABLE_CONSOLE=true

# -----------------------------------------------------------------------------
# Opcionais (têm valores padrão — só descomente se quiser ajustar)
# -----------------------------------------------------------------------------

# Máximo de eventos guardados na fila antes de descartar os mais antigos.
# MAX_QUEUE_SIZE=500

# Backoff de reconexão (ms): inicial e teto.
# BASE_RECONNECT_DELAY_MS=3000
# MAX_RECONNECT_DELAY_MS=60000

# Chave da EulerStream (serviço de assinatura usado pela lib).
# Opcional, mas recomendada em produção para evitar limites de taxa.
# Crie em https://www.eulerstream.com
# SIGN_API_KEY=
