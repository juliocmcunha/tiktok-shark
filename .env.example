# -----------------------------------------------------------------------------
# TikTok -> Roblox bridge server configuration
# Copy this file to ".env" and fill in the values.
#   cp .env.example .env
# (On first run the app can also generate this file for you automatically.)
# -----------------------------------------------------------------------------

# HTTP port the server will listen on.
PORT=3000

# TikTok username of the live to monitor (without the "@").
# The person MUST be live for the connection to succeed.
TIKTOK_USERNAME=your_username

# Secret key required in the "x-api-key" header of the /api/events endpoint.
# Use something long and random. Generate one, for example, with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=replace-with-a-long-random-key

# -----------------------------------------------------------------------------
# Test mode (test the Roblox integration WITHOUT going live)
# -----------------------------------------------------------------------------

# If "true": does NOT connect to TikTok. Starts only the HTTP API + sim console.
# Great for building the Roblox game before you have a real live.
# SIMULATE_ONLY=false

# Interactive console (stdin) to simulate events by typing commands.
# On by default when a terminal (TTY) is present. Force with true/false.
# ENABLE_CONSOLE=true

# Setup assistant type: gui | console | headless.
# Leave unset to auto-detect (browser form on desktop, console otherwise).
# UI_MODE=gui

# -----------------------------------------------------------------------------
# Optional (sensible defaults — uncomment only to tweak)
# -----------------------------------------------------------------------------

# Max events kept in the queue before the oldest are dropped.
# MAX_QUEUE_SIZE=500

# Reconnect backoff (ms): initial and cap.
# BASE_RECONNECT_DELAY_MS=3000
# MAX_RECONNECT_DELAY_MS=60000

# EulerStream API key (signing service used by the library).
# Optional, but recommended in production to avoid rate limits.
# Create one at https://www.eulerstream.com
# SIGN_API_KEY=
