{
  "name": "tiktok-roblox-bridge",
  "version": "1.0.0",
  "description": "Intermediary server that bridges a TikTok live to a Roblox game via HTTP polling.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start:ts": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs",
    "exe:bun": "bun build ./src/server.ts --compile --outfile tiktok-server"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "tiktok-live-connector": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
